# ===============================================================================
# Ymmo Project - Environment Variables Template
# Copy this to .env and fill in with actual values
# ===============================================================================

# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,ymmo.local,www.ymmo.local

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ymmo_db
DB_USER=ymmo_user
DB_PASSWORD=secure-db-password-here
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://ymmo_user:secure-db-password-here@db:5432/ymmo_db

# Redis Cache (optional)
REDIS_URL=redis://redis:6379/0
CACHE_TIMEOUT=3600

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security
CSRF_TRUSTED_ORIGINS=https://ymmo.local,https://www.ymmo.local
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Azure Configuration (for cloud deployment)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=ymmo-infra
AZURE_LOCATION=francecentral

# VPN Configuration
VPN_PROTOCOL=IPSec
VPN_ENCRYPTION=AES-256
VPN_PSK=your-preshared-key-here
VPN_SUBNET=10.0.0.0/16

# Active Directory
AD_SERVER=10.0.0.1
AD_DOMAIN=ymmo.local
AD_ADMIN_USER=ymmo_admin
AD_ADMIN_PASSWORD=secure-password-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ymmo/django.log

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@ymmo.local
PGADMIN_DEFAULT_PASSWORD=secure-pgadmin-password

# Storage (for media/static files)
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
STATIC_URL=/static/

# Gunicorn Configuration
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Application Settings
SITE_NAME=Ymmo Immobilier
SITE_DOMAIN=ymmo.local
DEFAULT_FROM_EMAIL=noreply@ymmo.local

# Celery Configuration (if using async tasks)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===============================================================================
# Production Deployment Notes:
# ===============================================================================
# 1. Use strong, randomly generated values for passwords/keys
# 2. Store sensitive values in Azure Key Vault or similar secret manager
# 3. Never commit .env file to version control
# 4. Rotate DATABASE_URL and SECRET_KEY regularly
# 5. Enable HTTPS with valid SSL certificates (not self-signed in prod)
# 6. Use managed Azure Database instead of containerized PostgreSQL
# 7. Enable backups and replication for high availability
# 8. Configure Azure Backup for daily backups
# 9. Use Azure Bastion for secure RDP access
# 10. Enable Azure Monitor for logging and alerting
